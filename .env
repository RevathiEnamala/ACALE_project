# Copy this file to ".env" and edit the copy.
# NEVER put real secrets in .env.example. This file is committed to Git.

# Run mode: development or production
ACALE_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR
ACALE_LOG_LEVEL=INFO

# Seed so simulation results are repeatable
ACALE_RANDOM_SEED=42

# Master secret (hex) used in a later phase to derive device keys.
# Leave EMPTY here. A secure value will be generated locally later in
# your private .env file only.
ACALE_MASTER_SECRET=f568cd50472e4a488f811aeda8564db51bf2400f4a7e595178b49a05ec583977